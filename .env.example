# Spike LLM Benchmark Environment Keys
# Duplicate this file to .env and insert valid test keys

# 1. Groq Cloud (Current Baseline) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google AI Studio (Contingency Alternative #1) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Mistral AI (Contingency Alternative #2 - Optional) - https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
